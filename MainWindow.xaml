<Window x:Class="CSharpRegexTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CSharpRegexTester"
        mc:Ignorable="d"
        Title="C# Regex Tester (.NET 10)"
        Height="720"
        Width="1120"
        MinHeight="540"
        MinWidth="860"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="QuickInsertButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Margin" Value="0,0,3,3"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <EventSetter Event="Click" Handler="RegexCharacterButton_Click"/>
        </Style>

        <Style x:Key="RegexOptionCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,2,12,2"/>
            <EventSetter Event="Checked" Handler="Checkbox_CheckChanged"/>
            <EventSetter Event="Unchecked" Handler="Checkbox_CheckChanged"/>
        </Style>

        <Style x:Key="MonospaceTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Panel: Quick-Insert Toolbar, Expression Input, Saved Expressions & RegexOptions -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left side of top panel: Toolbar + Expression TextBox + History -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Quick-Insert Token Toolbar -->
                <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                    <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Button x:Name="CaretButton" Style="{StaticResource QuickInsertButtonStyle}" Content="^" Tag="^" ToolTip="Start of string or line (^)"/>
                        <Button x:Name="DollarSignButton" Style="{StaticResource QuickInsertButtonStyle}" Content="$" Tag="$" Margin="0,0,8,3" ToolTip="End of string or line ($)"/>

                        <Button x:Name="WordCharacterButton" Style="{StaticResource QuickInsertButtonStyle}" Content="\w" Tag="\w" ToolTip="Word character (\w)"/>
                        <Button x:Name="NonWordCharacterButton" Style="{StaticResource QuickInsertButtonStyle}" Content="\W" Tag="\W" ToolTip="Non-word character (\W)"/>
                        <Button x:Name="DigitButton" Style="{StaticResource QuickInsertButtonStyle}" Content="\d" Tag="\d" ToolTip="Digit character (\d)"/>
                        <Button x:Name="NonDigitButton" Style="{StaticResource QuickInsertButtonStyle}" Content="\D" Tag="\D" ToolTip="Non-digit character (\D)"/>
                        <Button x:Name="WhitespaceButton" Style="{StaticResource QuickInsertButtonStyle}" Content="\s" Tag="\s" ToolTip="Whitespace character (\s)"/>
                        <Button x:Name="NonWhitespaceButton" Style="{StaticResource QuickInsertButtonStyle}" Content="\S" Tag="\S" ToolTip="Non-whitespace character (\S)"/>
                        <Button x:Name="WordBoundaryButton" Style="{StaticResource QuickInsertButtonStyle}" Content="\b" Tag="\b" Margin="0,0,8,3" ToolTip="Word boundary (\b)"/>

                        <Button x:Name="PeriodButton" Style="{StaticResource QuickInsertButtonStyle}" Content="." Tag="." ToolTip="Any character except newline (.)"/>
                        <Button x:Name="PlusSignButton" Style="{StaticResource QuickInsertButtonStyle}" Content="+" Tag="+" ToolTip="One or more times (+)"/>
                        <Button x:Name="AsteriskButton" Style="{StaticResource QuickInsertButtonStyle}" Content="*" Tag="*" Margin="0,0,8,3" ToolTip="Zero or more times (*)"/>

                        <Button x:Name="CharClassButton" Style="{StaticResource QuickInsertButtonStyle}" Content="[a-z]" Tag="[a-z]" ToolTip="Character range/set ([a-z])"/>
                        <Button x:Name="NegatedCharClassButton" Style="{StaticResource QuickInsertButtonStyle}" Content="[^...]" Tag="[^]" Margin="0,0,8,3" ToolTip="Negated character class ([^...])"/>

                        <Button x:Name="GroupButton" Style="{StaticResource QuickInsertButtonStyle}" Content="(...)" Tag="()" ToolTip="Capturing group (...) — wraps selected text"/>
                        <Button x:Name="NonCapturingGroupButton" Style="{StaticResource QuickInsertButtonStyle}" Content="(?:...)" Tag="(?:)" ToolTip="Non-capturing group (?:...) — wraps selected text"/>
                        <Button x:Name="NamedGroupButton" Style="{StaticResource QuickInsertButtonStyle}" Content="(?&lt;n&gt;)" Tag="(?&lt;name&gt;)" ToolTip="Named capturing group (?&lt;name&gt;...) — wraps selected text"/>
                        <Button x:Name="LookaheadButton" Style="{StaticResource QuickInsertButtonStyle}" Content="(?=...)" Tag="(?=)" ToolTip="Positive lookahead (?=...)"/>
                        <Button x:Name="LookbehindButton" Style="{StaticResource QuickInsertButtonStyle}" Content="(?&lt;=...)" Tag="(?&lt;=)" Margin="0,0,8,3" ToolTip="Positive lookbehind (?&lt;=...)"/>
                    </WrapPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CopyCSharpButton" Content="Copy as C#" Height="24" Padding="8,0" Margin="0,0,6,3" Click="CopyCSharpButton_Click" ToolTip="Copy ready-to-use C# [GeneratedRegex] and Regex code to clipboard"/>
                        <Button x:Name="ClearAllButton" Content="Clear All" Height="24" Padding="8,0" Margin="0,0,0,3" Click="ClearAllButton_Click" ToolTip="Clear expression, inputs, results, and reset all options"/>
                    </StackPanel>
                </DockPanel>

                <!-- Regular Expression Input with Native Watermark -->
                <Grid Grid.Row="1">
                    <TextBox x:Name="ExpressionTextBox"
                             Style="{StaticResource MonospaceTextBoxStyle}"
                             Height="68"
                             TextChanged="TextBox_TextChanged"/>
                    <TextBlock Text="Enter Regular Expression Here"
                               Margin="8,6,0,0"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Left"
                               Foreground="Gray"
                               FontFamily="Consolas"
                               FontSize="14"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=ExpressionTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Saved Expressions / Pattern History Bar -->
                <Grid Grid.Row="2" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Saved Patterns:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="SavedExpressionsComboBox"
                              Grid.Column="1"
                              Height="24"
                              FontFamily="Consolas"
                              SelectionChanged="SavedExpressionsComboBox_SelectionChanged"
                              ToolTip="Select a saved regular expression to load it"/>
                    <Button x:Name="SaveExpressionButton"
                            Grid.Column="2"
                            Content="Save Pattern"
                            Height="24"
                            Padding="8,0"
                            Margin="6,0,0,0"
                            Click="SaveExpressionButton_Click"
                            ToolTip="Save current expression to the saved patterns list"/>
                    <Button x:Name="RemoveSavedExpressionButton"
                            Grid.Column="3"
                            Content="Remove"
                            Height="24"
                            Padding="8,0"
                            Margin="6,0,0,0"
                            Click="RemoveSavedExpressionButton_Click"
                            ToolTip="Remove selected pattern from saved patterns"/>
                </Grid>
            </Grid>

            <!-- Right side of top panel: RegexOptions GroupBox -->
            <GroupBox Grid.Column="1" Header="Regex Options" Padding="8,6">
                <UniformGrid Rows="4" Columns="3">
                    <CheckBox x:Name="IgnoreCaseCheckBox" Style="{StaticResource RegexOptionCheckBoxStyle}" Content="IgnoreCase"/>
                    <CheckBox x:Name="ExplicitCaptureCheckBox" Style="{StaticResource RegexOptionCheckBoxStyle}" Content="ExplicitCapture"/>
                    <CheckBox x:Name="RightToLeftCheckBox" Style="{StaticResource RegexOptionCheckBoxStyle}" Content="RightToLeft" Margin="0,2,0,2"/>

                    <CheckBox x:Name="SinglelineCheckBox" Style="{StaticResource RegexOptionCheckBoxStyle}" Content="Singleline"/>
                    <CheckBox x:Name="ECMAScriptCheckBox" Style="{StaticResource RegexOptionCheckBoxStyle}" Content="ECMAScript"/>
                    <CheckBox x:Name="CompiledCheckBox" Style="{StaticResource RegexOptionCheckBoxStyle}" Content="Compiled" Margin="0,2,0,2"/>

                    <CheckBox x:Name="MultilineCheckBox" Style="{StaticResource RegexOptionCheckBoxStyle}" Content="Multiline"/>
                    <CheckBox x:Name="CultureInvariantCheckBox" Style="{StaticResource RegexOptionCheckBoxStyle}" Content="CultureInvariant"/>
                    <CheckBox x:Name="IgnorePatternWhitespace" Style="{StaticResource RegexOptionCheckBoxStyle}" Content="IgnorePatternWhitespace" Margin="0,2,0,2"/>

                    <CheckBox x:Name="NonBacktrackingCheckBox" Style="{StaticResource RegexOptionCheckBoxStyle}" Content="NonBacktracking" ToolTip="Guarantees linear-time matching in .NET 7+ (incompatible with RightToLeft and ECMAScript)"/>
                </UniformGrid>
            </GroupBox>
        </Grid>

        <!-- Main Content Area: Resizable Split View -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="320"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1.15*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Test Data, Replacement Text, Replacement Results -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.2*"/>
                </Grid.RowDefinitions>

                <Label x:Name="TestDataLabel" Grid.Row="0" Content="Test Data" Padding="0,2,0,4" FontWeight="Bold"/>
                <AdornerDecorator Grid.Row="1">
                    <TextBox x:Name="DataTextBox"
                             Style="{StaticResource MonospaceTextBoxStyle}"
                             HorizontalScrollBarVisibility="Auto"
                             TextChanged="TextBox_TextChanged"/>
                </AdornerDecorator>

                <Label x:Name="ReplacementTextLabel" Grid.Row="2" Content="Replacement Text" Padding="0,8,0,4" FontWeight="Bold"/>
                <TextBox x:Name="ReplacementTextTextBox"
                         Grid.Row="3"
                         Style="{StaticResource MonospaceTextBoxStyle}"
                         Height="56"
                         TextChanged="TextBox_TextChanged"/>

                <Label x:Name="ReplacementResultsLabel" Grid.Row="4" Content="Replacement Results" Padding="0,8,0,4" FontWeight="Bold"/>
                <TextBox x:Name="ReplacementResultsTextBox"
                         Grid.Row="5"
                         Style="{StaticResource MonospaceTextBoxStyle}"
                         IsReadOnly="True"/>
            </Grid>

            <!-- Resizable GridSplitter -->
            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True"/>

            <!-- Right Column: Match Results, Split Results, and C# Code Snippet -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <Label x:Name="MatchResultsLabel" DockPanel.Dock="Left" Content="Match Results" Padding="0,2,12,2" FontWeight="Bold" VerticalAlignment="Center"/>
                    <CheckBox x:Name="ExpandCapturesCheckBox" DockPanel.Dock="Left" Content="Expand Captures" Margin="0,0,12,0" VerticalAlignment="Center" Checked="Checkbox_CheckChanged" Unchecked="Checkbox_CheckChanged"/>
                    <CheckBox x:Name="ExpandGroupsCheckBox" DockPanel.Dock="Left" Content="Expand Groups" Margin="0,0,12,0" VerticalAlignment="Center" Checked="Checkbox_CheckChanged" Unchecked="Checkbox_CheckChanged"/>
                    <TextBlock x:Name="MatchSummaryTextBlock"
                               DockPanel.Dock="Right"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="#1565C0"
                               FontWeight="SemiBold"/>
                </DockPanel>

                <TabControl Grid.Row="1">
                    <TabItem Header="Matches &amp; Groups">
                        <TreeView x:Name="MatchesTreeView"
                                  FontFamily="Consolas"
                                  FontSize="13.5"
                                  SelectedItemChanged="MatchesTreeView_SelectedItemChanged"/>
                    </TabItem>
                    <TabItem Header="Regex.Split Results">
                        <ListBox x:Name="SplitResultsListBox"
                                 FontFamily="Consolas"
                                 FontSize="13.5"/>
                    </TabItem>
                    <TabItem Header="C# Code ([GeneratedRegex])">
                        <TextBox x:Name="CSharpSnippetTextBox"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 AcceptsReturn="True"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="6"/>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- Bottom Status & Action Bar -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusTextBlock"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="#555555"
                       Text="Ready"/>

            <Button x:Name="SaveAndExitButton"
                    Grid.Column="1"
                    Content="Save and Exit"
                    Height="26"
                    Width="110"
                    Click="SaveAndExitButton_Click"/>
        </Grid>
    </Grid>
</Window>
